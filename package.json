{
  "name": "@nervehq/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for Nerve Unified Notification-as-a-Service (NaaS) Platform",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/esm",
    "dist/cjs",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "codegen": "openapi-typescript ../nerve-docs/static/openapi/gateway.json -o src/generated/gateway.ts",
    "check:codegen": "node scripts/check-codegen.mjs",
    "check:types": "tsc --project tsconfig.check.json",
    "check:exports": "node scripts/check-exports.mjs",
    "check:changelog": "node scripts/check-changelog.mjs",
    "check:deprecations": "node scripts/check-deprecations.mjs",
    "check:release": "node scripts/check-release.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "sbom": "node scripts/sbom.mjs",
    "check": "npm run check:codegen && npm run check:types && npm run check:changelog && npm run check:deprecations && npm run check:release && npx tsc --noEmit",
    "verify": "npm run check && npm test",
    "test": "npm run test:coverage && npm run test:mutation",
    "test:coverage": "npm run build && tsx --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-include-all --test-coverage-exclude='src/generated/**' --test-coverage-exclude='src/types.ts' --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 tests/*.test.ts",
    "test:mutation": "node scripts/mutation-test.mjs",
    "dev": "tsx src/index.ts"
  },
  "author": "Nerve Engineering <engineering@ajianlabs.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.12.7",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
